PORT=4320
CRM_HOST=127.0.0.1
CRM_DATA_DIR=.data
# Seed fictional demo records into a completely empty database only.
CRM_DEMO=false
CRM_ALLOWED_ORIGINS=http://127.0.0.1:4320,http://localhost:4320,http://127.0.0.1:5176,http://localhost:5176
CRM_RATE_LIMIT=600
# Optional local API token; required if CRM_HOST is not loopback.
CRM_API_TOKEN=
# Deterministic mock agents are the default. External AI is opt-in.
CRM_AI_ENABLED=false
CRM_AI_MODEL=
GEMINI_API_KEY=
